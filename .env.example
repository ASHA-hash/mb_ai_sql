# =============================================================================
# SETUP (do this once per machine / host)
# =============================================================================
# 1. Copy this file to ".env" in this same folder:
#      copy .env.example .env
# 2. In ".env", replace every placeholder below (your_sql_server_host, your_username,
#    your_password, your_openai_secret_key_here) with real values.
# 3. Never commit ".env" or paste API keys/passwords into git, chat, or .env.example.
# 4. If an OpenAI key was ever exposed: revoke it at https://platform.openai.com/api-keys
#    and create a new one; put the new key only in ".env" or the host’s env vars.
# 5. Start the API:  npm start   (or node index.js)
# 6. Optional: run  python ../scripts/test_openai_api_key.py  from the parent folder
#    after setting OPENAI_API_KEY in the environment or in .env at repo root
#
# Render / other hosts: set the same variable names in the service environment (no .env file).
#
# --- API hardening (recommended for any public URL) ---
# If set, every /api/* request must send header: X-API-Key: <same value>
# (except GET /api/health — still open for load balancers).
# Apps Script: menu "Set ERP API key" or Script Property ERP_API_KEY.
# API_KEY=
#
# --- HTTP response tuning (Express compression + analytics partial payloads) ---
# gzip/deflate for responses over threshold (set X-No-Compression on request to skip).
# API_COMPRESSION_THRESHOLD_BYTES=1024
# Default analytics JSON to slim quality/reconciliation payload (can override per request with body.compact).
# API_ANALYTICS_COMPACT_DEFAULT=0
# Disable MessagePack encoding (Accept: application/x-msgpack or body.format / ?format=msgpack).
# API_MSGPACK_DISABLE=0
#
# --- Optional RBAC (who can see which datasets / tabs) ---
# RBAC_ENABLED=1  →  require header X-User-Email on /api/* (except /api/health).
#
# Where users & roles are stored:
#   • If RBAC_DATABASE_URL or DATABASE_URL is set → PostgreSQL tables erp_rbac_users / erp_rbac_roles.
#     (Render: create a Postgres instance, link it to this web service — DATABASE_URL is injected.)
#     First deploy copies roles + users from users-config.json into the DB if tables are empty; redeploys
#     still sync role *definitions* from users-config.json so Git stays the source for admin/manager/viewer caps.
#     User list + password hashes then live in Postgres and survive redeploys.
#   • If no DB URL → users-config.json on disk (RBAC_PERSIST=0 blocks Admin "Save" writing that file).
# RBAC_DATABASE_URL=   (optional override; else DATABASE_URL is used for RBAC)
# RBAC_PG_SSL=0        (optional: disable SSL for local Postgres only)
# RBAC_PERSIST=1       (file mode only) Admin tab "Save" can write users-config.json (0 = read-only).
# First bootstrap without DB: add your Gmail under "users" in users-config.json, deploy, then set RBAC_ENABLED=1.
#
# AI schema introspection (first AI query may take a few seconds):
# AI_SCHEMA_MAX_TABLES=18   (default 18 — how many registry tables get full column lists in the AI prompt)
# AI_SCHEMA_DISABLE=0
# Optional safety cap for AI-generated SQL TOP (N). Leave unset or 0 for no cap.
# AI_SQL_TOP_MAX=0
# Cap list-result row width (enforceTopLimit injects TOP when missing). Default 500.
# AI_SQL_MAX_RESULT_ROWS=500
# Comma-separated extra dbo views allowed through sql-validator (site-specific).
# AI_SQL_EXTRA_ALLOWED_VIEWS=dbo.MyCustomView
# Strict column check against INFORMATION_SCHEMA (can block valid aliases). Default off.
# LIVE_SCHEMA_VALIDATION=1
# =============================================================================

# --- HTTP ---
PORT=3000

# --- SQL Server (required for /api/dataset/* and /api/query/ai) ---
DB_SERVER=your_sql_server_host
DB_PORT=1433
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=zRetailHQ0

# Driver timeouts (milliseconds). Uncomment to override defaults (120000 / 60000).
# DB_REQUEST_TIMEOUT_MS=120000
# DB_CONNECT_TIMEOUT_MS=60000

# TLS to SQL Server (try true if you get handshake / connection errors; default is off).
# DB_ENCRYPT=true

# Render / dashboards: paste DB_* values with no surrounding quotes; accidental spaces are trimmed in code.

# --- OpenAI (required only for POST /api/query/ai — natural language → SQL) ---
# Without a valid key, the rest of the API still works; /api/query/ai returns 503.
OPENAI_API_KEY=your_openai_secret_key_here
OPENAI_MODEL=gpt-4o-mini
# Second OpenAI call: plain-English explanation after /api/query/adaptive runs. Set 0 to disable (saves latency/tokens).
# AI_ADAPTIVE_SUMMARY=1

# --- LangSmith tracing (FREE — see every AI query step in a visual dashboard) ---
# 1. Sign up at https://smith.langchain.com  (free tier covers dev usage)
# 2. Go to Settings → API Keys → Create API Key
# 3. Paste your key below, uncomment all 4 lines, restart the server
# Every LangGraph run (discover_views → get_schema → sample_data → generate_sql →
# check_sql → execute_sql → generate_answer → verify_answer) will appear in LangSmith.
#
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=smarterpconnector

# --- Dataset table/view overrides (optional) ---
# Defaults match datasets-registry.js; only change if your database uses different names.

SALES_VIEW=dbo.VwAISalesData
STOCK_VIEW=dbo.VwAIStockData
CUSTOMER_VIEW=dbo.VwAICustomerDetails
BRANCH_VIEW=dbo.VwAIBranch
SALESPERSON_TABLE=dbo.MstSalesPerson
STOCK_TABLE=dbo.MstStockUnit

# Legacy: used only when SALES_VIEW is unset (see GET /api/sales).
# SALES_TABLE=dbo.SomeLegacySalesTable

# --- Per-dataset URL filters (?from=&to=&fy=&branch=&department=&category=&status=) ---
# Column names must exist on that dataset’s view/table. Discover with:
#   SELECT TOP 5 * FROM dbo.VwAISalesData;
# Date: from/to accept yyyy-mm-dd or dd.mm.yyyy. fy=FY26 = 1 Apr 2025 – 31 Mar 2026 (India financial year).
# Uncomment and set to your real column names (examples only — wrong names break queries):
# SALES_FILTER_DATE_COLUMN=InvoiceDt
# SALES_FILTER_BRANCH_COLUMN=BranchId
# SALES_FILTER_DEPARTMENT_COLUMN=DepartmentName
# SALES_FILTER_CATEGORY_COLUMN=CategoryCode
# SALES_FILTER_STATUS_COLUMN=status
# Optional partial text match (default is exact =):
# SALES_FILTER_BRANCH_MATCH=like
# SALES_FILTER_DEPARTMENT_MATCH=like
# SALES_FILTER_CATEGORY_MATCH=like

# Other datasets: same pattern using PREFIX from datasets-registry.js (filterPrefix).
# Entries with skipDateParamsIfNoColumn (supplier, item/customer/branch masters, etc.): optional —
# clients may send ?from/&to but the API ignores dates until you set *_FILTER_DATE_COLUMN.
#   {PREFIX}_FILTER_DATE_COLUMN
#   {PREFIX}_FILTER_BRANCH_COLUMN
#   {PREFIX}_FILTER_DEPARTMENT_COLUMN
#   {PREFIX}_FILTER_CATEGORY_COLUMN
#   {PREFIX}_FILTER_STATUS_COLUMN
#
# PREFIX values in use:
#   SALES, STOCK, CUSTOMERS, BRANCHES, SALESPERSON, STOCK_UNITS,
#   VW_AI_SUPPLIER, VW_AIMST_ITEMS, VW_AI_SALESPERSON, VW_MST_BRANCH_ENTRY, VW_MST_ITEMS,
#   MB_POWERBI_APP_REPORT, MB_POWERBI_APR_REPORT, MB_POWERBI_BRANCH_LIST, MB_POWERBI_CATEGORY_MASTER,
#   MB_POWERBI_CBS_WITH_GIT, MB_POWERBI_MIS_SUPPLIER_SLS_DATA, MB_POWERBI_PRODUCT_MASTER,
#   MB_POWERBI_PRT_REPORT, MB_POWERBI_PUR_QTY_WITH_COST, MB_POWERBI_PUR_REPORT, MB_POWERBI_PURXNS_REPORT,
#   MB_POWERBI_SLS_ARTICLE_REPORT, MB_POWERBI_SLS_BILLCOUNT, MB_POWERBI_SLS_REPORT, MB_POWERBI_SLSXNS_REPORT,
#   MB_POWERBI_STI_REPORT, MB_POWERBI_STO_REPORT, MB_POWERBI_STOCK_REPORT,
#   MB_POWERBI_SUPPLIER_PUR_REPORT, MB_POWERBI_VENDOR_MASTER

# --- Optional: PostgreSQL mirror (npm run mirror-sync) ---
# Full connection string — replace YOUR_PG_HOST, USER, PASSWORD, YOUR_DB:
# MIRROR_DATABASE_URL=postgresql://USER:PASSWORD@YOUR_PG_HOST:5432/YOUR_DB
# Comma-separated dataset keys (must match datasets-registry.js):
# MIRROR_SYNC_KEYS=sales,stock
# Max rows per dataset (1–500, same cap as API):
# MIRROR_ROW_LIMIT=500
#
# Allow Sheets/API to READ snapshots (GET /api/dataset/:key?source=mirror + sidebar checkbox):
# MIRROR_READ_ENABLED=1
# If mirror errors or snapshot missing, run live SQL Server query instead:
# MIRROR_READ_FALLBACK_LIVE=1
#
# --- Query reliability (services/query-reliability.js) ---
# Transient retries reuse SQL_QUERY_RETRIES / db-resilience.js. After live failure, optionally serve PG mirror:
# QUERY_RELIABILITY_MIRROR_ON_LIVE_FAILURE=0     # 1 = use MIRROR_DATABASE_URL snapshot when SQL Server query fails
# QUERY_RELIABILITY_WEBHOOK_URL=               # Slack/Teams-style POST JSON (mirror fallback, final failures)
# QUERY_RELIABILITY_WEBHOOK_MIN_MS=120000
# QUERY_RELIABILITY_ALERT_EMPTY_FILTERED=0     # 1 = log+throttle-webhook when filtered query returns 0 rows (noisy)

# --- Analytics Engine (POST /api/analytics/dashboard + dashboard Analytics tab) ---
# LRU cache TTL (ms) and tuning:
# ANALYTICS_CACHE_TTL_MS=120000
# ANALYTICS_CACHE_MAX_KEYS=400
# Breakdown TOP N cap (server-side) and max trend points (downsampled beyond this):
# ANALYTICS_BREAKDOWN_CAP=60
# ANALYTICS_TREND_MAX_POINTS=400
# Chart decision engine: max points for progressive/sampling hints (services/chart-decision-engine.js)
# CHART_ENGINE_MAX_POINTS=500
# Optional: override sales view columns used for rollups (must exist on VwAISalesData or your view):
# SALES_ANALYTICS_AMOUNT_COLUMN=SaleNetAmount
# SALES_ANALYTICS_BRANCH_DIM=BranchName
# SALES_ANALYTICS_DEPARTMENT_DIM=DepartmentName
# SALES_ANALYTICS_CATEGORY_DIM=CategoryName
# After ETL / manual refresh: POST /api/analytics/invalidate-cache (admin) bumps cache epoch for all clients.
# Duplicate-line probe (optional keys → COUNT vs COUNT DISTINCT). Set to 0 to skip.
# SALES_ANALYTICS_DEDUPE_KEYS=InvoiceId,LineNo
# SALES_ANALYTICS_DEDUPE_CHECK=1
# Reject dashboard requests wider than N days (guardrail).
# ANALYTICS_MAX_SPAN_DAYS=800
# Optional: point rollups at a pre-aggregated table/view (same column names as sales view).
# ANALYTICS_BASE_TABLE=dbo.YourRollupDaily
#
# Faster dashboard path: daily grain rollup (SaleDate × branch × dept × category). See scripts/analytics-rollups.sql.
# Column names must match SALES_ANALYTICS_* + date filter column (SaleNetAmount, LineCount ...).
# ANALYTICS_USE_LINE_ROLLUP=1
# ANALYTICS_ROLLUP_DAILY_TABLE=dbo.ErpAgg_Sales_Day_Branch_Dept_Cat
# ANALYTICS_ROLLUP_LINECOUNT_COLUMN=LineCount
#
# Query planner (services/analytics-query-planner.js): cache TTL multipliers, rollup vs raw, join heuristics.
# ANALYTICS_PLANNER_SMART_ROLLUP=0       # 1 = choose rollup only for wide spans / large estimated raw rows (sys.partitions)
# ANALYTICS_ROLLUP_MIN_SPAN_DAYS=14
# ANALYTICS_ROLLUP_MIN_RAW_ROWS=5000000
# ANALYTICS_CACHE_TTL_SHORT_RANGE_MULT=0.5   # MTD / spans ≤7d
# ANALYTICS_CACHE_TTL_LONG_RANGE_MULT=1.5    # FY or spans >180d
# ANALYTICS_PLANNER_LARGE_SCAN_ROWS=5000000  # joinPlan.largeScan hint thresholds
# ANALYTICS_PLANNER_LARGE_SCAN_DAYS=400
# ANALYTICS_CACHE_DISABLE=0            # 1 = never read analytics cache (always live query)
# ANALYTICS_FORCE_LIVE=0               # Same as cache disable (ops)
# ANALYTICS_RETURN_PLAN=0              # 1 = include queryPlan object on dashboard API JSON (trace + estimates)
#
# Trend forecasting (OLS linear + optional Holt smoothing) — dotted future series on analytics trend chart.
# ANALYTICS_FORECAST_ENABLE=0
# ANALYTICS_FORECAST_HORIZON=4         # periods ahead (months or days, matching trend granularity)
# ANALYTICS_FORECAST_METHOD=linear     # linear | holt (holt needs ANALYTICS_FORECAST_MIN_POINTS_HOLT points)
# ANALYTICS_FORECAST_MIN_POINTS=5
# ANALYTICS_FORECAST_MIN_POINTS_HOLT=8
# ANALYTICS_FORECAST_HOLT_ALPHA=0.35
# ANALYTICS_FORECAST_HOLT_BETA=0.12
#
# Auto insights (deterministic; compares current range vs equal-length prior window + branch vs median).
# ANALYTICS_INSIGHTS_ENABLE=0
# ANALYTICS_INSIGHTS_MIN_SPAN_DAYS=3
# ANALYTICS_INSIGHTS_MIN_PRIOR_FOR_PCT=1000       # below this prior total, avoid % headlines
# ANALYTICS_INSIGHTS_PCT_NOISE_FLOOR=3           # ignore % swings smaller than this (noise)
# ANALYTICS_INSIGHTS_MIN_BRANCHES=4
# ANALYTICS_INSIGHTS_MIN_BRANCH_REVENUE=25000
# ANALYTICS_INSIGHTS_BRANCH_UNDERPERFORM_RATIO=0.55   # flag if branch < ratio × median (must exceed ANALYTICS_INSIGHTS_MIN_BRANCH_REVENUE)
# ANALYTICS_INSIGHTS_MAX_BRANCH_FLAGS=3
# ANALYTICS_INSIGHTS_CONCENTRATION_WARN=0.72   # warn when one branch > this share of branch-total sales
#
# Cap for deterministic-ai daily summary query (avoid full-scan GROUP BY on huge history).
# PREAGG_DAILY_HISTORY_DAYS=800
#
# Row-level change / ETL watermark (MAX on this column shown in dashboard for sync trust).
# SALES_ANALYTICS_WATERMARK_COLUMN=ModifiedAt
# Tolerance for sum(trend buckets) vs KPI total (decimal, e.g. 0.015 = 1.5%). Skipped during month drill-down.
# ANALYTICS_KPI_TREND_TOLERANCE=0.015
#
# Dashboard vs line-level source (canonical sales view): checksum + optional SQL compare when using rollups/base override.
# ANALYTICS_RECONCILE=auto   # auto = extra query only when rollup or ANALYTICS_BASE_TABLE differs from source | 1=always | 0=off
# ANALYTICS_RECONCILE_MONEY_PCT=0.005
# ANALYTICS_RECONCILE_TXN_ABS=50
# ANALYTICS_RECONCILE_TXN_PCT=0.005
# Cron / CI: npm run reconcile:dashboard -- mtd  (or RECON_PERIODS=mtd,qtd node scripts/reconcile-analytics.js)
#
# Pre-visualization anomaly scan (runs before charts; see services/analytics-quality.js):
# ANOMALY_USE_MAD=1                  # Robust level outliers (median/MAD modified z-score)
# ANOMALY_USE_STEP=1                  # Period-over-period % change outliers on trend series
# ANOMALY_USE_CLASSIC_Z=0             # Gaussian z on levels (off by default; MAD is primary)
# ANOMALY_BREAKDOWN_IQR=1             # Branch/dept/category IQR outliers
# ANOMALY_MAD_THRESHOLD=3.5
# ANOMALY_POP_Z_THRESHOLD=2.8
# ANOMALY_POP_ABS_PCT=0.75          # Warn when step change exceeds this fractional move AND z-score
# Optional alerting (warn-level + anomaly_* codes, duplicate_rows, etc. — throttled):
# ANOMALY_WEBHOOK_URL=https://hooks.slack.com/services/...
# ANOMALY_WEBHOOK_MIN_MS=300000
# ANOMALY_LOG_ALERTS=1              # console JSON for debugging
#
# Optional Redis L2 cache for POST /api/analytics/dashboard (install: npm install ioredis).
# ANALYTICS_REDIS_URL=redis://127.0.0.1:6379
# (or use generic REDIS_URL)
#
# --- KPIs & monitoring (GET /api/monitoring/kpis) ---
# When set, send header X-Monitoring-Key: <same> (bypasses RBAC user JWT for this route only).
# MONITORING_API_KEY=your_long_random_secret
# MONITORING_ROLLING_SIZE=400
# MONITORING_REQUEST_LOG=0          # 1 = log every instrumented request: [metric] route ms status
# SLO targets (documentation / alert thresholds — compared in your external dashboard):
# KPI_TARGET_QUERY_MS=8000
# KPI_TARGET_DASHBOARD_MS=3000
# KPI_TARGET_FRESHNESS_LAG_MS=10800000   # e.g. 3 hours in ms
# KPI_TARGET_ERROR_RATE=0.01           # max acceptable 5xx share
#
# --- Production: errors, retries, logging, rate limits, failover hooks ---
# NODE_ENV=production
# TRUST_PROXY=1                      # Behind nginx/Render/ALB — correct client IP for rate limits
# SHOW_ERROR_DETAILS=0               # If 1, 500 responses include real exception text (avoid in public prod)
# PRODUCTION_LOG_JSON=1                # One JSON log line per event (also auto when NODE_ENV=production)
# LOG_LEVEL=info                     # error | warn | info | debug
#
# Rate limiting (set RATE_LIMIT_ENABLED=0 to disable — dev/tests only):
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_API_WINDOW_MS=900000
# RATE_LIMIT_API_MAX=800             # per IP per window for general /api/*
# RATE_LIMIT_AI_WINDOW_MS=60000
# RATE_LIMIT_AI_MAX=30               # POST /api/query/ai|adaptive|agentic per IP per minute
# RATE_LIMIT_ANALYTICS_WINDOW_MS=60000
# RATE_LIMIT_ANALYTICS_MAX=90        # POST /api/analytics/dashboard per IP per minute
#
# SQL resilience
# DB_CONNECT_RETRIES=5               # Exponential backoff when SQL Server is cold or unreachable
# SQL_QUERY_RETRIES=2               # Retry once on transient query errors (timeouts, connection reset)
#
# Failover / degradation (application-level — configure per layer):
# - DB: multiple connect attempts (above); use Always On listener host in DB_SERVER when available.
# - Reads: optional read replica not wired in code — point DB_SERVER at your listener for HA.
# - Mirror: MIRROR_READ_FALLBACK_LIVE=1 lets dataset reads fall back to live SQL if mirror snapshot misses.
# - Analytics cache: ANALYTICS_REDIS_URL survives process restarts vs memory-only LRU.
